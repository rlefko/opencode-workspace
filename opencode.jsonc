{
	"$schema": "https://opencode.ai/config.json",
	"model": "lmstudio/qwen/qwen3.6-27b",
	"small_model": "lmstudio/qwen/qwen3.6-35b-a3b",
	"provider": {
		"lmstudio": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "LM Studio (local)",
			"options": {
				"baseURL": "http://127.0.0.1:1234/v1",
				"timeout": false
			},
			"models": {
				"qwen/qwen3.6-27b": {
					"name": "qwen3.6-27b",
					"limit": { "context": 262144, "output": 32768 },
					"modalities": { "input": ["image", "text"], "output": ["text"] }
				},
				"qwen/qwen3.6-35b-a3b": {
					"name": "qwen3.6-35b-a3b",
					"limit": { "context": 262144, "output": 32768 },
					"modalities": { "input": ["image", "text"], "output": ["text"] }
				}
			}
		}
	},
	"permission": {
		"task": "deny",
		"delegate": "deny",
		"workflow": "deny",
		"workflow_status": "deny",
		"context7_*": "deny",
		"exa_*": "deny",
		"gh_grep_*": "deny",
		"kagi_*": "deny",
		"webfetch": "deny",
		"worktree_*": "deny"
	},
	"agent": {
		"plan": {
			"mode": "primary",
			"model": "lmstudio/qwen/qwen3.6-27b",
			"temperature": 0.3,
			"reasoningEffort": "high",
			"textVerbosity": "low",
			"permission": {
				"edit": "deny",
				"write": "deny",
				"bash": {
					"*": "deny",
					"ls *": "allow",
					"tree *": "allow",
					"pwd": "allow",
					"cat *": "allow",
					"head *": "allow",
					"tail *": "allow",
					"wc *": "allow",
					"grep *": "allow",
					"rg *": "allow",
					"find *": "allow",
					"git status*": "allow",
					"git log*": "allow",
					"git diff*": "allow",
					"git show*": "allow",
					"git blame*": "allow",
					"git branch*": "allow",
					"git ls-files*": "allow"
				},
				"task": "allow",
				"delegate": "allow",
				"workflow": "allow",
				"workflow_status": "allow",
				"worktree_*": "allow"
			}
		},
		"build": {
			"mode": "primary",
			"model": "lmstudio/qwen/qwen3.6-27b",
			"temperature": 0.3,
			"reasoningEffort": "high",
			"textVerbosity": "low",
			"permission": {
				"read": "allow",
				"write": "allow",
				"edit": "allow",
				"glob": "allow",
				"grep": "allow",
				"bash": "allow",
				"task": "allow",
				"delegate": "allow",
				"workflow": "allow",
				"workflow_status": "allow",
				"worktree_*": "allow"
			}
		},
		"coder": {
			"mode": "subagent",
			"model": "lmstudio/qwen/qwen3.6-27b",
			"temperature": 0.2,
			"reasoningEffort": "high",
			"textVerbosity": "low",
			"permission": {
				"context7_*": "deny",
				"exa_*": "deny",
				"gh_grep_*": "deny",
				"read": "allow",
				"write": "allow",
				"edit": "allow",
				"glob": "allow",
				"grep": "allow",
				"bash": "allow",
				"plan_read": "deny",
				"todoread": "deny"
			}
		},
		"explore": {
			"mode": "subagent",
			"model": "lmstudio/qwen/qwen3.6-35b-a3b",
			"temperature": 0.2,
			"reasoningEffort": "low",
			"textVerbosity": "low",
			"permission": {
				"edit": "deny",
				"write": "deny",
				"plan_read": "deny",
				"todoread": "deny",
				"bash": {
					"*": "deny",
					"ls *": "allow",
					"tree *": "allow",
					"pwd": "allow",
					"cat *": "allow",
					"head *": "allow",
					"tail *": "allow",
					"wc *": "allow",
					"file *": "allow",
					"stat *": "allow",
					"grep *": "allow",
					"rg *": "allow",
					"find *": "allow",
					"git status*": "allow",
					"git log*": "allow",
					"git diff*": "allow",
					"git show*": "allow",
					"git blame*": "allow",
					"git branch*": "allow",
					"git ls-files*": "allow",
					"uname*": "allow",
					"hostname": "allow",
					"whoami": "allow",
					"which *": "allow",
					"realpath *": "allow"
				}
			}
		},
		"researcher": {
			"mode": "subagent",
			"model": "lmstudio/qwen/qwen3.6-35b-a3b",
			"temperature": 0.4,
			"reasoningEffort": "high",
			"textVerbosity": "medium",
			"permission": {
				"context7_*": "allow",
				"exa_*": "allow",
				"gh_grep_*": "allow",
				"kagi_*": "deny",
				"webfetch": "allow",
				"write": "deny",
				"edit": "deny",
				"plan_read": "deny",
				"todoread": "deny",
				"bash": {
					"*": "deny",
					"gh repo view*": "allow",
					"gh pr view*": "allow",
					"gh pr list*": "allow",
					"gh issue view*": "allow",
					"gh issue list*": "allow",
					"gh release view*": "allow",
					"gh release list*": "allow",
					"gh run view*": "allow",
					"gh run list*": "allow",
					"gh workflow list*": "allow",
					"gh search *": "allow",
					"gh api *": "allow",
					"npm view*": "allow",
					"npm info*": "allow",
					"npm show*": "allow",
					"pip show*": "allow",
					"pip index*": "allow",
					"cargo search*": "allow",
					"cargo info*": "allow",
					"man *": "allow",
					"tldr *": "allow",
					"dig *": "allow",
					"nslookup *": "allow",
					"whois *": "allow",
					"host *": "allow",
					"jq *": "allow",
					"head *": "allow",
					"tail *": "allow",
					"base64 *": "allow",
					"grep *": "allow",
					"rg *": "allow",
					"wc *": "allow",
					"sort *": "allow",
					"uniq *": "allow",
					"cut *": "allow",
					"awk *": "allow",
					"tr *": "allow"
				}
			}
		},
		"scribe": {
			"mode": "subagent",
			"model": "lmstudio/qwen/qwen3.6-35b-a3b",
			"temperature": 1,
			"reasoningEffort": "low",
			"textVerbosity": "high",
			"permission": {
				"bash": {
					"*": "deny"
				},
				"edit": "allow",
				"glob": "allow",
				"read": "allow",
				"write": "allow",
				"plan_read": "deny",
				"todoread": "deny"
			}
		},
		"reviewer": {
			"mode": "subagent",
			"model": "lmstudio/qwen/qwen3.6-35b-a3b",
			"temperature": 0.1,
			"reasoningEffort": "high",
			"textVerbosity": "medium",
			"permission": {
				"edit": "deny",
				"write": "deny",
				"bash": {
					"*": "deny",
					"git diff*": "allow",
					"git log*": "allow",
					"git show*": "allow",
					"git blame*": "allow",
					"rg *": "allow"
				},
				"plan_read": "allow",
				"delegation_read": "allow",
				"delegation_list": "allow",
				"workflow_status": "allow"
			}
		},
		"general": {
			"mode": "subagent",
			"model": "lmstudio/qwen/qwen3.6-35b-a3b",
			"temperature": 0.3,
			"reasoningEffort": "medium",
			"textVerbosity": "low",
			"permission": {
				"context7_*": "allow",
				"exa_*": "allow",
				"gh_grep_*": "allow",
				"read": "allow",
				"write": "allow",
				"edit": "allow",
				"glob": "allow",
				"grep": "allow",
				"bash": "allow",
				"plan_read": "allow",
				"todoread": "allow"
			}
		},
		"scout": {
			"mode": "subagent",
			"model": "lmstudio/qwen/qwen3.6-35b-a3b",
			"temperature": 0.3,
			"reasoningEffort": "medium",
			"textVerbosity": "low",
			"permission": {
				"context7_*": "allow",
				"exa_*": "allow",
				"gh_grep_*": "allow",
				"kagi_*": "deny",
				"webfetch": "allow",
				"write": "deny",
				"edit": "deny",
				"plan_read": "deny",
				"todoread": "deny",
				"bash": {
					"*": "deny",
					"gh repo view*": "allow",
					"gh pr view*": "allow",
					"gh pr list*": "allow",
					"gh issue view*": "allow",
					"gh issue list*": "allow",
					"gh release view*": "allow",
					"gh release list*": "allow",
					"gh run view*": "allow",
					"gh run list*": "allow",
					"gh workflow list*": "allow",
					"gh search *": "allow",
					"gh api *": "allow",
					"npm view*": "allow",
					"npm info*": "allow",
					"npm show*": "allow",
					"pip show*": "allow",
					"pip index*": "allow",
					"cargo search*": "allow",
					"cargo info*": "allow",
					"man *": "allow",
					"tldr *": "allow",
					"dig *": "allow",
					"nslookup *": "allow",
					"whois *": "allow",
					"host *": "allow",
					"jq *": "allow",
					"head *": "allow",
					"tail *": "allow",
					"base64 *": "allow",
					"grep *": "allow",
					"rg *": "allow",
					"wc *": "allow",
					"sort *": "allow",
					"uniq *": "allow",
					"cut *": "allow",
					"awk *": "allow",
					"tr *": "allow"
				}
			}
		},
		"compaction": {
			"mode": "primary",
			"model": "lmstudio/qwen/qwen3.6-27b",
			"permission": {
				"edit": "deny",
				"write": "deny",
				"bash": {
					"*": "deny"
				}
			}
		},
		"title": {
			"mode": "primary",
			"model": "lmstudio/qwen/qwen3.6-35b-a3b",
			"permission": {
				"edit": "deny",
				"write": "deny",
				"bash": {
					"*": "deny"
				}
			}
		}
	},
	"mcp": {
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true
		},
		"exa": {
			"type": "remote",
			"url": "https://mcp.exa.ai/mcp",
			"enabled": true
		},
		"gh_grep": {
			"type": "remote",
			"url": "https://mcp.grep.app",
			"enabled": true
		}
	},
	"instructions": [
		"./tools/philosophy.md"
	],
	"plugin": [
		"@tarquinen/opencode-dcp@3.1.3",
		"@franlol/opencode-md-table-formatter@0.0.6"
	]
}
